{
  "name": "cluide-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "develop": "strapi develop",
    "start": "mkdir -p public/uploads && strapi start",
    "build": "strapi build && cp -r config dist/ && find src -name '*.json' | xargs -I{} sh -c 'mkdir -p dist/$(dirname {}) && cp {} dist/{}'",
    "strapi": "strapi"
  },
  "dependencies": {
    "@strapi/strapi": "5.47.1",
    "@strapi/plugin-users-permissions": "5.47.1",
    "better-sqlite3": "^9.4.3",
    "pg": "^8.12.0",
    "typescript": "^5.3.3",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  }
}
